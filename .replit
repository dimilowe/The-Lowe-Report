modules = ["nodejs-20", "postgresql-16"]

[agent]
expertMode = true
integrations = ["javascript_stripe:1.0.0", "javascript_database:1.0.0", "javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = []

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dev Server"

[[workflows.workflow]]
name = "Next.js Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-lc", "PORT=5000 npm run start"]
build = ["sh", "-lc", "npm run build"]

[objectStorage]
defaultBucketID = "replit-objstore-622e1fe1-7db8-4567-affd-97aede2f9d66"
